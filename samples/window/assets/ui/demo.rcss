/* Unidades em dp: 1dp = altura da janela / 720 (UiDocument::designHeight). */
body {
    width: 100%;
    height: 100%;
    font-family: Barlow;
    font-size: 15dp;
    color: #e8edf2;
}
h1 {
    display: block;
    font-weight: bold;
    font-size: 20dp;
    margin-bottom: 4dp;
}
p {
    display: block;
    margin-bottom: 6dp;
}
.panel {
    position: absolute;
    right: 14dp;
    top: 14dp;
    width: 300dp;
    padding: 12dp 14dp;
    background-color: #151a20e6;
    border: 1dp #ffffff1a;
    border-radius: 10dp;
}
.stats {
    color: #9ba6b2;
    font-size: 13dp;
}
.buttons {
    display: flex;
    gap: 8dp;
    margin-top: 4dp;
}
button {
    display: block;
    padding: 6dp 10dp;
    background-color: #1d242c;
    border: 1dp #ffffff1a;
    border-radius: 7dp;
    color: #e8edf2;
    font-weight: bold;
    font-size: 13dp;
    cursor: pointer;
}
button:hover {
    border-color: #ffffff3d;
}
button.on {
    background-color: #f2c230;
    color: #1b1505;
}
